-- ---------- 2. FUNÇÕES BÁSICAS ----------
create or replace function norm(t text) returns text language sql immutable as
$$ select regexp_replace(lower(extensions.unaccent(trim(t))),'\s+',' ','g') $$;
-- celular: só dígitos, com 55 na frente (aceita 10/11 dígitos ou já com 55)
create or replace function norm_phone(t text) returns text language sql immutable as $$
  select case when d ~ '^55\d{10,11}$' then d when d ~ '^\d{10,11}$' then '55'||d else null end
  from (select regexp_replace(coalesce(t,''),'\D','','g') d) x $$;
create or replace function fmt_phone(p text) returns text language sql immutable as $$
  select case when p is null then null
    when length(p)=13 then '+55 ('||substr(p,3,2)||') '||substr(p,5,5)||'-'||substr(p,10)
    when length(p)=12 then '+55 ('||substr(p,3,2)||') '||substr(p,5,4)||'-'||substr(p,9) else p end $$;
create or replace function set_norm() returns trigger language plpgsql as $$
begin
  new.normalized_name:=norm(new.name);
  new.phone:=nullif(trim(coalesce(new.phone,'')),'');
  if new.phone is not null then
    new.phone:=norm_phone(new.phone);
    if new.phone is null then raise exception 'telefone_invalido'; end if;
  end if;
  return new;
end $$;
drop trigger if exists t_norm on guests;
create trigger t_norm before insert or update of name, phone on guests for each row execute function set_norm();

