drop function if exists verify_guest(text);

-- Qualquer pessoa confirma com o nome: cria o convidado (se novo) + pedido PENDENTE. Você decide pelo Telegram.
create or replace function confirm_attendance(p_name text) returns jsonb language plpgsql security definer set search_path=public as $$
declare v text:=regexp_replace(trim(coalesce(p_name,'')),'\s+',' ','g'); g guests; v_new uuid;
begin
  perform rl();
  if char_length(v) not between 3 and 80 or v ~ '[<>]' then return '{"ok":false}'; end if;
  insert into guests(name) values (v) on conflict (normalized_name) do nothing;
  select * into g from guests where normalized_name=norm(v);
  if not found or not g.is_active then return '{"ok":true,"already":true}'; end if;
  insert into attendance(guest_id) values (g.id) on conflict (guest_id) do nothing returning id into v_new;
  return jsonb_build_object('ok',true,'already',v_new is null,'token',v_new);  -- token só existe para quem acabou de confirmar
end $$;

-- A pessoa cadastra o próprio celular usando o token recebido ao confirmar (ninguém consegue mexer no celular de outro)
create or replace function save_phone(p_token uuid, p_phone text) returns jsonb language plpgsql security definer set search_path=public as $$
declare g guests; np text:=norm_phone(p_phone);
begin
  perform rl();
  if np is null then return '{"ok":false,"error":"invalid"}'; end if;
  select gg.* into g from attendance a join guests gg on gg.id=a.guest_id where a.id=p_token;
  if not found then return '{"ok":false}'; end if;
  update guests set phone=np where id=g.id;
  perform tg_admins_msg('📱 <b>'||tg_esc(g.name)||'</b> adicionou o celular '||fmt_phone(np));
  return '{"ok":true}';
end $$;

create or replace function public_confirmed() returns table(name text) language sql security definer set search_path=public as
$$ select g.name from attendance a join guests g on g.id=a.guest_id where a.status='approved' order by a.approved_at nulls last $$;

grant execute on function confirm_attendance(text), save_phone(uuid,text), public_confirmed() to anon, authenticated;

