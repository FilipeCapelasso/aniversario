create or replace function notify_list_change() returns trigger language plpgsql security definer set search_path=public,extensions as $$
begin
  if tg_table_name='attendance' then
    if (tg_op<>'INSERT' and old.status='approved') or (tg_op<>'DELETE' and new.status='approved') then
      perform realtime.send(jsonb_build_object('at',now()),'changed','confirmed',false);
    end if;
  else
    perform realtime.send(jsonb_build_object('at',now()),'changed','confirmed',false);
  end if;
  return null;
exception when others then return null;
end $$;

